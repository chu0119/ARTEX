# Docker 部署配置（复制为 .env）
ARTEX_TAG=latest
# 镜像名：默认 ghcr.io/chu0119/artex；拉取慢或需换源时可覆盖
# ARTEX_IMAGE=ghcr.io/chu0119/artex
POSTGRES_USER=artex
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=artex

# LLM（二选一或都填；也可留空到 UI 里配）
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ARTEX_LLM_PROVIDER=
ARTEX_LLM_MODEL=
ARTEX_LLM_BASE_URL=
ARTEX_LLM_PROXY=
