# Docker 部署配置（复制为 .env）
ARTEX_TAG=latest
# 镜像名：默认 xingchuan1314/artex（Docker Hub）；拉取慢可换 ghcr.io/chu0119/artex
# ARTEX_IMAGE=xingchuan1314/artex
POSTGRES_USER=artex
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=artex

# LLM（二选一或都填；也可留空到 UI 里配）
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ARTEX_LLM_PROVIDER=
ARTEX_LLM_MODEL=
ARTEX_LLM_BASE_URL=
ARTEX_LLM_PROXY=
